# Environment variables for production
# This file is loaded by Vite in production mode
# Note: All Vite environment variables must be prefixed with VITE_

# API Base URL for production
VITE_API_URL=https://crm.oceantechnolab.com/api
# VITE_API_URL=http://localhost:8000/api


# Facebook Lead Import Feature
# Set to 'true' to enable Facebook lead import functionality in production
# Default: false (disabled in production)
VITE_SHOW_FACEBOOK_LEAD_IMPORT=false

# Authentication Method
# Set to 'cookie' to use cookie-based authentication (default for production)
VITE_AUTH_METHOD=cookie
