# Environment variables for development (local overrides)
# This file is loaded by Vite in development mode
# Copy this file to .env.local and customize your local settings
# Note: .env.local is gitignored and won't be committed

# API Base URL for development
# VITE_API_URL=https://oceancrm.onrender.com/api
VITE_API_URL=http://localhost:8000/api
# Authentication Method
# Set to 'token' to use localStorage-based token authentication (for staging/development)
# Set to 'cookie' to use cookie-based authentication (default for production)
VITE_AUTH_METHOD=cookie

# Facebook Lead Import Feature
# Set to 'true' to enable Facebook lead import functionality
VITE_SHOW_FACEBOOK_LEAD_IMPORT=false
VITE_ENABLE_DEVTOOLS=false
